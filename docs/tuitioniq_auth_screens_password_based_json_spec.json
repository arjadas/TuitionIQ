{
  "auth_screens": [
    {
      "id": "login",
      "frame": "Login",
      "layout": "vertical",
      "padding": "24px 20px",
      "gap": 16,
      "sections": [
        {
          "id": "logo_block",
          "type": "LogoBlock",
          "alignment": "center",
          "marginBottom": 32,
          "children": [
            { "type": "Image", "asset": "tuitioniq_logo", "height": 48 },
            {
              "type": "Text",
              "content": "Manage your students with ease",
              "style": "caption_secondary"
            }
          ]
        },
        {
          "id": "form",
          "type": "FormSection",
          "gap": 12,
          "children": [
            {
              "type": "InputField",
              "name": "email",
              "label": "Email address",
              "keyboardType": "email-address",
              "autocomplete": "email",
              "returnKey": "next"
            },
            {
              "type": "InputField",
              "name": "password",
              "label": "Password",
              "secureEntry": true,
              "rightIcon": "EyeToggle",
              "returnKey": "done"
            },
            {
              "type": "TextLink",
              "name": "forgot_password",
              "label": "Forgot password?",
              "alignment": "right",
              "navigateTo": "ForgotPasswordScreen"
            }
          ]
        },
        {
          "type": "PrimaryButton",
          "label": "Sign In",
          "loadingLabel": "Signing in…",
          "action": "submitLogin",
          "fullWidth": true,
          "height": 48
        },
        {
          "type": "TextLink",
          "name": "sign_up",
          "label": "Don't have an account? Sign up",
          "alignment": "center",
          "navigateTo": "SignupScreen"
        }
      ],
      "validation": {
        "email": ["required", "email_format"],
        "password": ["required"]
      },
      "error_messages": {
        "invalid_credentials": "Email or password is incorrect. Try again.",
        "unverified": "Please verify your email before signing in.",
        "network": "No internet connection. Check your connection and try again."
      }
    },
    {
      "id": "signup",
      "frame": "Signup",
      "layout": "vertical",
      "padding": "24px 20px",
      "gap": 16,
      "sections": [
        { "type": "BackButton", "navigateTo": "LoginScreen" },
        { "type": "ScreenTitle", "content": "Create Account" },
        {
          "id": "form",
          "type": "FormSection",
          "gap": 12,
          "children": [
            {
              "type": "Row",
              "gap": 10,
              "children": [
                {
                  "type": "InputField",
                  "name": "first_name",
                  "label": "First name",
                  "flex": 1,
                  "autocomplete": "given-name",
                  "returnKey": "next"
                },
                {
                  "type": "InputField",
                  "name": "last_name",
                  "label": "Last name",
                  "flex": 1,
                  "autocomplete": "family-name",
                  "returnKey": "next"
                }
              ]
            },
            {
              "type": "InputField",
              "name": "email",
              "label": "Email address",
              "keyboardType": "email-address",
              "autocomplete": "email",
              "returnKey": "next"
            },
            {
              "type": "InputField",
              "name": "password",
              "label": "Password",
              "secureEntry": true,
              "rightIcon": "EyeToggle",
              "textContentType": "newPassword",
              "returnKey": "next"
            },
            {
              "type": "PasswordStrengthBar",
              "linkedTo": "password",
              "levels": ["Weak", "Fair", "Good", "Strong"],
              "colors": ["#DC2626", "#D97706", "#16A34A", "#15803D"]
            },
            {
              "type": "InputField",
              "name": "confirm_password",
              "label": "Confirm password",
              "secureEntry": true,
              "rightIcon": "EyeToggle",
              "returnKey": "done"
            },
            {
              "type": "TermsCheckbox",
              "label": "I agree to the Terms of Service and Privacy Policy",
              "links": {
                "Terms of Service": "https://tuitioniq.com/terms",
                "Privacy Policy": "https://tuitioniq.com/privacy"
              }
            }
          ]
        },
        {
          "type": "PrimaryButton",
          "label": "Create Account",
          "loadingLabel": "Creating account…",
          "action": "submitSignup",
          "fullWidth": true,
          "height": 48,
          "requiresValid": true
        },
        {
          "type": "TextLink",
          "name": "sign_in",
          "label": "Already have an account? Sign in",
          "alignment": "center",
          "navigateTo": "LoginScreen"
        }
      ],
      "validation": {
        "first_name": ["required", "min:2"],
        "last_name": ["required", "min:2"],
        "email": ["required", "email_format", "unique"],
        "password": ["required", "min:8", "strength:fair"],
        "confirm_password": ["required", "matches:password"],
        "terms": ["checked"]
      }
    },
    {
      "id": "forgot_password",
      "frame": "ForgotPassword",
      "layout": "vertical",
      "padding": "24px 20px",
      "gap": 16,
      "sections": [
        { "type": "BackButton", "navigateTo": "LoginScreen" },
        { "type": "ScreenTitle", "content": "Forgot Password" },
        {
          "type": "HelperText",
          "content": "Enter the email address linked to your account and we'll send you a reset link."
        },
        {
          "type": "InputField",
          "name": "email",
          "label": "Email address",
          "keyboardType": "email-address"
        },
        {
          "type": "PrimaryButton",
          "label": "Send Reset Link",
          "loadingLabel": "Sending…",
          "action": "submitForgotPassword",
          "fullWidth": true,
          "height": 48
        },
        {
          "type": "TextLink",
          "name": "back_to_login",
          "label": "Back to Sign In",
          "alignment": "center",
          "navigateTo": "LoginScreen"
        }
      ],
      "success_state": {
        "type": "SuccessCard",
        "icon": "check_circle",
        "title": "Check your inbox",
        "body": "We've sent a reset link to {email}",
        "actions": [
          {
            "type": "ResendLink",
            "cooldown_seconds": 60,
            "label": "Resend link",
            "cooldownLabel": "Resend in {n}s"
          },
          {
            "type": "TextLink",
            "label": "Back to Sign In",
            "navigateTo": "LoginScreen"
          }
        ]
      },
      "security_note": "Always show success state regardless of whether email exists in system"
    },
    {
      "id": "reset_password",
      "frame": "ResetPassword",
      "entry": "deep_link",
      "deep_link_param": "token",
      "layout": "vertical",
      "padding": "24px 20px",
      "gap": 16,
      "token_check": "validate_on_mount",
      "sections": [
        {
          "type": "ScreenTitle",
          "content": "Reset Password",
          "alignment": "center"
        },
        {
          "type": "HelperText",
          "content": "Choose a strong new password for your account."
        },
        {
          "type": "InputField",
          "name": "new_password",
          "label": "New password",
          "secureEntry": true,
          "rightIcon": "EyeToggle",
          "textContentType": "newPassword"
        },
        { "type": "PasswordStrengthBar", "linkedTo": "new_password" },
        {
          "type": "InputField",
          "name": "confirm_new_password",
          "label": "Confirm new password",
          "secureEntry": true,
          "rightIcon": "EyeToggle"
        },
        {
          "type": "PrimaryButton",
          "label": "Set New Password",
          "loadingLabel": "Updating password…",
          "action": "submitResetPassword",
          "fullWidth": true,
          "height": 48
        },
        {
          "type": "TextLink",
          "name": "back_to_login",
          "label": "Back to Sign In",
          "alignment": "center",
          "navigateTo": "LoginScreen"
        }
      ],
      "expired_state": {
        "type": "ErrorCard",
        "icon": "clock_warning",
        "title": "Link expired",
        "body": "This reset link has expired or already been used.",
        "action": {
          "type": "PrimaryButton",
          "label": "Request new link",
          "navigateTo": "ForgotPasswordScreen"
        }
      },
      "success_state": {
        "type": "SuccessCard",
        "icon": "check_circle",
        "title": "Password updated!",
        "body": "Sign in with your new password.",
        "action": {
          "type": "PrimaryButton",
          "label": "Go to Sign In",
          "navigateTo": "LoginScreen",
          "replaceStack": true
        },
        "auto_redirect_seconds": 3
      }
    }
  ]
}
