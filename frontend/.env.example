# Supabase Configuration
# Your Supabase project URL
# Format: https://[projectref].supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (safe for frontend)
# This is the public anon key, not the service role key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API Base URL
# Where the backend API is deployed
# Format: https://api.tuitioniq.com or http://localhost:5100 for local dev
EXPO_PUBLIC_API_BASE_URL=