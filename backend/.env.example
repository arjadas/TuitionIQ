# used through the .NET configuration system, accessed via IConfiguration in the application code.
# locally set up secrets using `dotnet user-secrets`

# Supabase Configuration
# Your Supabase project reference (e.g., "abcdefgh")
Supabase__ProjectRef=

# Supabase service role key (KEEP SECRET - backend only)
# Never commit or share this value
Supabase__ServiceRoleKey=

# Database Connection String
# PostgreSQL connection string from Supabase
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
ConnectionStrings__DefaultConnection=